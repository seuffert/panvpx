<?xml version="1.0"?>
<ruleset name="PanVPX Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">
    <description>Custom ruleset for PanVPX</description>
    
    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/>
    </rule>
    <rule ref="category/java/codestyle.xml">
        <exclude name="OnlyOneReturn"/>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>
    <rule ref="category/java/design.xml">
        <exclude name="LoosePackageCoupling"/>
        <exclude name="LawOfDemeter"/>
    </rule>
    <rule ref="category/java/errorprone.xml">
        <exclude name="BeanMembersShouldSerialize"/>
    </rule>

    <rule ref="category/java/codestyle.xml/LocalVariableCouldBeFinal"/>
    <rule ref="category/java/codestyle.xml/MethodArgumentCouldBeFinal"/>
    
    <!-- Rule customization for boolean properties: isXxx() not getXxx() -->
    <rule ref="category/java/errorprone.xml/MethodNamingConventions">
        <!-- This is a custom configuration point. PMD defaults usually check method casing, but strict "is" prefix is harder to enforce purely via PMD without custom XPath. We just rely on standard java conventions via PMD. -->
    </rule>
</ruleset>
